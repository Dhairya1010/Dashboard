{
  "name": "personal-productivity-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:api": "wrangler dev --config worker/wrangler.jsonc --local --test-scheduled",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config worker/wrangler.jsonc",
    "typecheck:api": "tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "build:api": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir dist/worker",
    "deploy:production": "npm run build && wrangler deploy --config worker/wrangler.production.jsonc"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
